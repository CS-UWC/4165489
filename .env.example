# Copy this file to .env and fill in the values for your own testbed.
# .env is gitignored. Never commit real credentials, tunnel URLs or device IPs.

# MQTT broker on the gateway
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=esp32user
MQTT_PASS=

# Node3 serial bridge (Arduino Nano)
BRIDGE_BAUD=115200

# Dashboard
DASH_HOST=0.0.0.0
DASH_PORT=5000
